.container {
  height: 100vh;
  background-color: #00cec9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 40rpx;
}

.mode-selector {
  display: flex;
  gap: 20rpx;
  margin-bottom: 60rpx;
}

.mode-item {
  font-size: 24rpx;
  padding: 15rpx 25rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.mode-item.active {
  background: white;
  color: #00cec9;
  font-weight: bold;
}

.circle-container {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.breathing-circle {
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  transition: all 4s ease-in-out;
}

/* 动态调整缩放速度以匹配呼吸模式 */
.breathing-circle.inhale {
  transform: scale(2.2);
  background: rgba(255, 255, 255, 0.6);
}

.breathing-circle.hold {
  transform: scale(2.2);
  background: rgba(255, 255, 255, 0.4);
}

.breathing-circle.exhale {
  transform: scale(1);
  background: rgba(255, 255, 255, 0.2);
}

.status-text {
  margin-top: 80rpx;
  font-size: 44rpx;
  font-weight: 300;
  letter-spacing: 4rpx;
}

.phase-count {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-family: monospace;
  opacity: 0.7;
}

.timer {
  margin-top: 60rpx;
  font-size: 80rpx;
  font-family: monospace;
  opacity: 0.8;
}

.footer {
  position: absolute;
  bottom: 100rpx;
}

.btn-action {
  background: white;
  color: #00cec9;
  border-radius: 50rpx;
  padding: 0 100rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 20rpx rgba(0,0,0,0.1);
}
