<view class="container">
  <view class="section">
    <view class="section-title">我的提醒清单</view>
    
    <view class="reminder-item" wx:for="{{reminders}}" wx:key="id">
      <view class="item-header">
        <input class="edit-title" value="{{item.title}}" bindinput="onTitleInput" data-id="{{item.id}}"/>
        <text class="btn-delete" bindtap="deleteReminder" data-id="{{item.id}}">删除</text>
      </view>
      <view class="item-desc">
        <input class="edit-desc" value="{{item.desc}}" placeholder="提醒描述，如：站起来走动2分钟" bindinput="onDescInput" data-id="{{item.id}}"/>
      </view>
      <view class="item-slider">
        <text class="label">间隔: {{item.interval}} 分钟</text>
        <slider bindchange="onIntervalChange" value="{{item.interval}}" min="1" max="180" show-value activeColor="#00b894" data-id="{{item.id}}"/>
      </view>
    </view>

    <button class="btn-add" bindtap="addReminder">+ 添加新提醒</button>
  </view>

  <view class="section">
    <view class="section-title">提醒生效时间</view>
    <view class="item-time">
      <text class="label">开始时间</text>
      <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
        <view class="time-value">{{startTime}}</view>
      </picker>
    </view>
    <view class="item-time">
      <text class="label">结束时间</text>
      <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
        <view class="time-value">{{endTime}}</view>
      </picker>
    </view>
    <view class="time-hint" wx:if="{{startTime > endTime}}">跨天模式：提醒将持续到次日结束时间</view>

    <view class="item-switch">
      <text class="label">系统级通知 (允许后台弹出)</text>
      <switch checked="{{subscribe}}" bindchange="onSubscribeChange" color="#0984e3"/>
    </view>
    <view class="item-switch">
      <text class="label">勿扰模式 (22:00 - 次日 8:00 自动静默)</text>
      <switch checked="{{dnd}}" bindchange="onDndChange" color="#00b894"/>
    </view>
    <view class="item-switch">
      <text class="label">震动提醒</text>
      <switch checked="{{sound}}" bindchange="onSoundChange" color="#00b894"/>
    </view>
  </view>

  <view class="footer">
    <button class="btn-save" bindtap="saveAll">保存并应用</button>
  </view>
</view>
