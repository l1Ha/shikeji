.container {
  padding: 30rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.section {
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.03);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3436;
  margin-bottom: 30rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f1f2f6;
}

.reminder-item {
  padding: 20rpx;
  background: #fdfdfd;
  border: 1rpx solid #f1f2f6;
  border-radius: 15rpx;
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.edit-title {
  font-size: 30rpx;
  color: #2d3436;
  border-bottom: 2rpx solid #eee;
  padding: 5rpx 10rpx;
  flex: 1;
  margin-right: 20rpx;
}

.btn-delete {
  font-size: 24rpx;
  color: #ff7675;
  padding: 10rpx;
}

.item-desc {
  margin-bottom: 10rpx;
}

.edit-desc {
  font-size: 26rpx;
  color: #636e72;
  background: #f1f2f6;
  border-radius: 10rpx;
  padding: 10rpx 15rpx;
}

.item-slider {
  margin-top: 10rpx;
}

.label {
  font-size: 26rpx;
  color: #636e72;
}

.btn-add {
  background: #f1f2f6;
  color: #0984e3;
  font-size: 28rpx;
  margin-top: 20rpx;
  border-radius: 10rpx;
}

.item-time {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}

.time-value {
  font-size: 30rpx;
  color: #0984e3;
  font-weight: bold;
}

.item-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.footer {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.btn-save {
  background-color: #00b894;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 184, 148, 0.2);
}

.time-hint {
  font-size: 22rpx;
  color: #e17055;
  margin: -8rpx 0 20rpx;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background-color: #12161c;
  }
  .section {
    background: #1e242d;
    box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.25);
  }
  .section-title {
    color: #e8eaed;
    border-bottom-color: #303845;
  }
  .reminder-item {
    background: #262d38;
    border-color: #303845;
  }
  .edit-title {
    color: #e8eaed;
    border-bottom-color: #303845;
  }
  .edit-desc {
    color: #a0a6ad;
    background: #1b2027;
  }
  .label {
    color: #a0a6ad;
  }
  .time-value {
    color: #4a9ff5;
  }
  .btn-add {
    background: #262d38;
    color: #4a9ff5;
  }
  .btn-save {
    box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.35);
  }
}
