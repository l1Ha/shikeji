.container {
  padding: 30rpx;
  background-color: #f0f3f6;
  min-height: 100vh;
  box-sizing: border-box;
}

.summary-card {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  border-radius: 30rpx;
  padding: 40rpx;
  color: white;
  display: flex;
  align-items: center;
  gap: 30rpx;
  box-shadow: 0 10rpx 20rpx rgba(108, 92, 231, 0.2);
  margin-bottom: 30rpx;
}

.summary-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 180rpx;
}

.summary-num {
  font-size: 72rpx;
  font-weight: bold;
  line-height: 1.1;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.summary-divider {
  width: 1rpx;
  height: 90rpx;
  background: rgba(255, 255, 255, 0.3);
}

.summary-side {
  flex: 1;
  display: flex;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 36rpx;
  font-weight: bold;
}

.summary-key {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.chart-card {
  background: white;
  border-radius: 30rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 30rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f2f6;
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2d3436;
}

.chart-today {
  font-size: 24rpx;
  color: #00b894;
  font-weight: bold;
}

.chart {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  height: 300rpx;
}

.bar-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.bar-score {
  font-size: 22rpx;
  color: #636e72;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.bar-track {
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 28rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: #b2bec3;
  transition: height 0.5s ease;
}

.bar-today {
  background: linear-gradient(180deg, #00cec9, #00b894);
}

.bar-empty {
  background: #e4e7eb;
}

.bar-label {
  font-size: 22rpx;
  color: #b2bec3;
  margin-top: 12rpx;
}

.label-today {
  color: #00b894;
  font-weight: bold;
}

.tips-card {
  background: white;
  border-radius: 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #2d3436;
  margin-bottom: 12rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #636e72;
  line-height: 1.6;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background-color: #12161c;
  }
  .chart-card,
  .tips-card {
    background: #1e242d;
    box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.25);
  }
  .chart-header {
    border-bottom-color: #303845;
  }
  .chart-title,
  .tips-title {
    color: #e8eaed;
  }
  .tips-text {
    color: #a0a6ad;
  }
  .bar-score {
    color: #a0a6ad;
  }
  .bar-empty {
    background: #303845;
  }
}
