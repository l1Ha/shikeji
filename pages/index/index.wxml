<view class="container">
  <view class="user-info">
    <button class="score-card" open-type="share">
      <text class="score-label">今日健康分</text>
      <text class="score-value">{{healthScore}}</text>
      <text class="streak-badge">🔥 已坚持 {{streakDays}} 天</text>
      <text class="share-hint">点击分享</text>
    </button>
    <view class="quote-box" bindtap="refreshQuote">
      <text class="quote-text">“{{currentQuote}}”</text>
      <text class="quote-sub">点击换一句</text>
    </view>
  </view>

  <view class="reminders">
    <view class="card {{item.status}}" wx:for="{{reminders}}" wx:key="id">
      <view class="card-icon-box">
        <image class="card-icon" src="/images/{{item.type || 'logo'}}.svg"></image>
      </view>
      <view class="card-content">
        <view class="card-header">
          <text class="card-title">{{item.title}}</text>
          <text class="countdown">{{item.remainingTimeStr}}</text>
        </view>
        <view class="card-body">
          <text class="card-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="card-footer">
        <button class="btn-done {{item.remainingTime > 0 ? 'btn-pending' : 'btn-ready'}}" 
                bindtap="completeTask" 
                data-id="{{item.id}}"
                disabled="{{item.remainingTime > 0}}">
          {{item.remainingTime > 0 ? '待完成' : '已完成'}}
        </button>
      </view>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-item" bindtap="startBreathing">
      <view class="action-icon breathing-icon"></view>
      <text>1分钟呼吸法</text>
    </view>
    <view class="action-item" bindtap="openStats">
      <view class="action-icon stats-icon"></view>
      <text>健康周报</text>
    </view>
  </view>
</view>
