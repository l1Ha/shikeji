.container {
  padding: 30rpx;
  background-color: #f0f3f6;
  min-height: 100vh;
}

.user-info {
  display: flex;
  margin-bottom: 40rpx;
  gap: 20rpx;
}

.score-card {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  padding: 30rpx;
  border-radius: 30rpx;
  color: white;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-width: 200rpx;
  box-shadow: 0 10rpx 20rpx rgba(108, 92, 231, 0.2);
  margin: 0;
  line-height: inherit;
  border: none;
}

.score-card::after {
  border: none;
}

.streak-badge {
  font-size: 20rpx;
  margin-top: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.score-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
}

.share-hint {
  font-size: 18rpx;
  opacity: 0.7;
  margin-top: 5rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.quote-box {
  flex: 1;
  background: white;
  padding: 30rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.05);
}

.quote-text {
  font-size: 28rpx;
  color: #2d3436;
  font-style: italic;
  margin-bottom: 10rpx;
  display: block;
}

.quote-sub {
  font-size: 22rpx;
  color: #b2bec3;
  text-align: right;
}

.reminders {
  width: 100%;
}

.card {
  background: white;
  border-radius: 30rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.03);
  transition: all 0.3s ease;
  display: flex;
  align-items: flex-start;
  gap: 30rpx;
  flex-wrap: wrap;
}

.card-icon-box {
  width: 80rpx;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-icon {
  width: 50rpx;
  height: 50rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2d3436;
}

.countdown {
  font-size: 32rpx;
  font-family: monospace;
  color: #00b894;
  font-weight: bold;
}

.card-desc {
  font-size: 28rpx;
  color: #636e72;
  margin-bottom: 30rpx;
  display: block;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
}

.btn-done {
  margin: 0;
  font-size: 26rpx;
  border-radius: 50rpx;
  padding: 0 40rpx;
  border: none;
  transition: all 0.3s ease;
}

.btn-pending {
  background: #f1f2f6;
  color: #b2bec3;
}

.btn-ready {
  background: #00b894;
  color: white;
  box-shadow: 0 4rpx 10rpx rgba(0, 184, 148, 0.3);
}

.btn-done::after {
  border: none;
}

.quick-actions {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}

.action-item {
  background: white;
  padding: 30rpx 60rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.05);
}

.breathing-icon {
  width: 40rpx;
  height: 40rpx;
  background: #00cec9;
  border-radius: 50%;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(0.8); opacity: 0.5; }
}
